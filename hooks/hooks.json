{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/settings-change-notify.py\" \"${CLAUDE_PLUGIN_ROOT}/.settings.toml\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/settings-change-notify.py\" --cleanup",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
